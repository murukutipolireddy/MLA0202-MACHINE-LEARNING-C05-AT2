# TD Learning

import random

# Learning rate
alpha = 0.1

# Discount factor
gamma = 0.9

# Number of episodes
episodes = 100

# Game states
states = ["Start", "Level1", "Level2", "Level3", "Goal"]

# Initialize state values
V = {state: 0.0 for state in states}

for episode in range(episodes):

    current_state = "Start"

    while current_state != "Goal":

        # Get next state
        current_index = states.index(current_state)

        next_state = states[current_index + 1]

        # Reward
        if next_state == "Goal":
            reward = 10
        else:
            reward = -1

        # TD Target
        td_target = reward + gamma * V[next_state]

        # TD Error
        td_error = td_target - V[current_state]

        # Update state value
        V[current_state] = (
            V[current_state] +
            alpha * td_error
        )

        # Move to next state
        current_state = next_state

print("Learned State Values:")

for state in states:
    print(state, ":", round(V[state], 3))
